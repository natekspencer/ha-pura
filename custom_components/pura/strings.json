  "exceptions": {
    "away_mode_active": {
      "message": "Away mode is currently active. Return to your space or disable away mode in order to control your diffuser"
    },
    "fragrance_slot_empty": {
      "message": "Slot {slot} does not have a fragrance installed"
    },
    "invalid_device": {
      "message": "Device {name} does not support setting timers"
    },
    "no_fragrances_installed": {
      "message": "Diffuser does not have any fragrances"
    },
    "no_active_fragrance": {
      "message": "No fragrance is currently active. Please select a fragrance before adjusting intensity"
    },
    "no_devices_found": {
      "message": "Unable to start timer(s) - no valid Pura devices were targeted"
    }
  },
  "services": {
    "start_timer": {
      "name": "Start timer",
      "description": "Start a fragrance timer.",
      "fields": {
        "area_id": {
          "description": "The area(s) to target. If an area is specified, all Pura devices in that area will be targeted.",
          "name": "Area ID(s)"
        },
        "device_id": {
          "description": "The device(s) to target, filtered by Pura models.",
          "name": "Device ID(s)"
        },
        "slot": {
          "description": "The slot of an available fragrance. Leave blank to automatically select the fragrance with the most scent remaining.",
          "name": "Slot"
        },
        "intensity": {
          "description": "The intensity of the fragrance. 1 is the lowest (gentle), and 10 is the highest (intense).",
          "name": "Intensity"
        },
        "duration": {
          "description": "How long the diffuser should run for.",
          "name": "Duration"
        }
      }
    }
  }
