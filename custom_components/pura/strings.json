      },
      "fragrance": {
        "name": "Fragrance",
        "state_attributes": {
          "color": {
            "name": "Color"
          }
        }
      },
      "fragrance_installed": {
        "name": "Fragrance installed"
      },
      "fragrance_remaining": {
        "name": "Fragrance remaining"
